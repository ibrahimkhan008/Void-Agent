# ─── Production environment for the VPS stack ────────────────────────────
# Copy to .env.production on the VPS (repo root), fill every value, then:
#   docker compose -f docker/compose.production.yml --env-file .env.production up -d --build

# ─── Database ───
# Strong password for the Postgres container (generate: openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ─── Auth (REQUIRED) ───
# 32+ char random secret (openssl rand -base64 48)
BETTER_AUTH_SECRET=CHANGE_ME
# The PUBLIC URL users visit — no trailing slash
BETTER_AUTH_URL=https://app.your-domain.com
NEXT_PUBLIC_BASE_URL=https://app.your-domain.com
# Comma-separated origins allowed to call auth endpoints
BETTER_AUTH_TRUSTED_ORIGINS=https://app.your-domain.com

# ─── Encryption (REQUIRED) ───
# 32-char key for AES-256-GCM API key storage (openssl rand -hex 16)
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_CHARS

# ─── Model providers (sign up / reuse keys from apps/web/.env) ───
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
FLARE_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=

# ─── Social sign-in (optional — update callbacks to the public URL) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Security ───
CHAT_REQUEST_GUARD_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EMBED_JWT_SECRET=

# ─── Tool providers (optional features) ───
EXA_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
SUPADATA_API_KEY=
E2B_API_KEY=
COMPOSIO_API_KEY=
ASSEMBLYAI_API_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Billing (optional — enables checkout) ───
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=

# ─── Scheduled jobs (optional — HTTP cron) ───
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
SCHEDULED_TASK_SECRET=
