# ─── Production environment for the VPS stack ────────────────────────────
# Copy to .env.production on the VPS (repo root), fill every value, then:
#   docker compose -f docker/compose.production.yml --env-file .env.production up -d --build

# ─── Database ───
# Strong password for the Postgres container (generate: openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ─── Auth (REQUIRED) ───
# 32+ char random secret (openssl rand -base64 48)
BETTER_AUTH_SECRET=CHANGE_ME
# The PUBLIC URL users visit — no trailing slash
BETTER_AUTH_URL=https://app.your-domain.com
NEXT_PUBLIC_BASE_URL=https://app.your-domain.com
# Comma-separated origins allowed to call auth endpoints
BETTER_AUTH_TRUSTED_ORIGINS=https://app.your-domain.com

# ─── Encryption (REQUIRED) ───
# 32-char key for AES-256-GCM API key storage (openssl rand -hex 16)
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_CHARS

# ─── Model providers (sign up / reuse keys from apps/web/.env) ───
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
FLARE_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=

# ─── Social sign-in (optional — update callbacks to the public URL) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Security ───
CHAT_REQUEST_GUARD_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EMBED_JWT_SECRET=

# ─── Tool providers (optional features) ───
EXA_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
SUPADATA_API_KEY=
E2B_API_KEY=
E2B_APP_BUILDER_TEMPLATE=void-agent-web
E2B_EXECUTION_TEMPLATE=void-agent-code-interpreter
COMPOSIO_API_KEY=
# Browser automation provider: Kernel (cloud) when KERNEL_API_KEY is set,
# otherwise the free open-source agent-browser CLI fallback — install it with
# `npm i -g agent-browser && agent-browser install` and (optionally) point
# AGENT_BROWSER_BIN at the native binary if it is not on PATH.
KERNEL_API_KEY=
# B20 egress isolation — a browser provider binds ONLY when its boundary is
# configured: Kernel needs KERNEL_EGRESS_MODE=managed; Steel needs
# STEEL_EGRESS_PROXY_URL (the egress-proxy service in the compose file);
# agent-browser needs AGENT_BROWSER_EGRESS_PROXY_URL. See DEPLOY-VPS.md §9.
KERNEL_EGRESS_MODE=
STEEL_EGRESS_PROXY_URL=
AGENT_BROWSER_EGRESS_PROXY_URL=
AGENT_BROWSER_BIN=
# Self-hosted Steel (free Kernel replacement, single concurrent session):
# point the app at the compose services above. The public URL is where YOUR
# browser loads the live view (route it via your tunnel + Access — Steel has
# no auth). Both must be set for the provider to activate.
STEEL_BASE_URL=
STEEL_EXECUTOR_URL=
STEEL_PUBLIC_BASE_URL=
ASSEMBLYAI_API_KEY=
# ElevenLabs: Scribe STT for the composer dictation + Realtime for voice chat
# (the AI Gateway stays the voice-chat fallback when unset). The app mints
# short-lived single-use tokens/client secrets server-side; the key never
# reaches the browser. For local dev the ElevenLabs CLI (npx @elevenlabs/cli
# onboard init) writes this key to the repo-root .env.local instead.
ELEVENLABS_API_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Billing (optional — enables checkout) ───
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=

# ─── Scheduled jobs (optional — HTTP cron) ───
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
SCHEDULED_TASK_SECRET=
