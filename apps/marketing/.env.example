# Marketing site (apps/marketing) — public configuration only.
# No secrets belong here: this app holds no database, no auth, no server keys.

# Canonical origin of the marketing site (this app).
NEXT_PUBLIC_MARKETING_URL=https://voidagent.space

# Absolute origin of the product application (apps/web) — used for every
# cross-domain link (Sign in, Sign up) and the pricing checkout API.
NEXT_PUBLIC_APP_URL=https://app.voidagent.space
